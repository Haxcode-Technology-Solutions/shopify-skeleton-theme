{% comment %} Newsletter section {% endcomment %}
{% if section.settings.show_newsletter %}
  <div class="footer-newsletter-section">
    <div class="footer-newsletter__container">
      <h3 class="footer-newsletter__heading">{{ section.settings.newsletter_heading | default: "Be the first to save!" }}</h3>
      <form action="{{ routes.root_url }}contact#footer-newsletter" method="post" class="footer-newsletter__form" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Enter your email address" required aria-label="Email address" class="footer-newsletter__input">
        <button type="submit" class="footer-newsletter__button">SUBSCRIBE</button>
      </form>
    </div>
  </div>
{% endif %}

{% comment %} Main footer {% endcomment %}
<footer class="site-footer">
  <div class="footer__main">
    <div class="footer__container">
      <div class="footer__grid">
        <div class="footer__column footer__column--about">
          <h3 class="footer__heading">About Us</h3>
          <div class="footer__text">
            {{ section.settings.about_text | default: "<p>Best of fragrance has been America's #1 place to buy discounted perfumes online since 2000. We stock more than 13,000 women's and men's fragrances, all of them deliverable to your door within just days.</p>" }}
          </div>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">{{ section.settings.column_1_heading | default: "bestoffragrances.com" }}</h3>
          <ul class="footer__links">
            {% if section.settings.menu_1 != blank %}
              {% for link in section.settings.menu_1.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="#">Privacy and Policy</a></li>
              <li><a href="#">About Us</a></li>
              <li><a href="#">Bulk Order</a></li>
              <li><a href="#">Advanced Search</a></li>
              <li><a href="#">Orders and Returns</a></li>
              <li><a href="#">Contact Us</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">Customer Service</h3>
          <ul class="footer__links">
            {% if section.settings.menu_2 != blank %}
              {% for link in section.settings.menu_2.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="#">Returns Policy</a></li>
              <li><a href="#">Product Recalls</a></li>
              <li><a href="#">Sitemap</a></li>
              <li><a href="#">Clearance</a></li>
              <li><a href="#">Perfume Coupons</a></li>
              <li><a href="#">Affiliate Program</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">In the spotlight</h3>
          <ul class="footer__links">
            {% if section.settings.menu_3 != blank %}
              {% for link in section.settings.menu_3.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="#">Perfumes</a></li>
              <li><a href="#">Body Care</a></li>
              <li><a href="#">Skin Care</a></li>
              <li><a href="#">Testers</a></li>
              <li><a href="#">Gift Sets</a></li>
              <li><a href="#">All Brands</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">Contact Us</h3>
          <div class="footer__contact">
            <p><strong>{{ section.settings.store_name | default: "Best of Fragrances, By Niralco LLC," }}</strong></p>
            <p>{{ section.settings.address | default: "2880 Cochran Street #1024, Simi Valley, CA 93065" }}</p>
            <p>Contact: {{ section.settings.phone | default: "(888) 647-1234" }}</p>
            {% if section.settings.email != blank %}
              <p>Email: <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__container">
      <div class="footer__bottom-content">
        <div class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: "Best of Fragrances By Niral Co LLC." }}
        </div>

        <div class="footer__payment">
          {% if section.settings.show_payment_icons %}
            <img src="https://cdn.shopify.com/s/files/1/0558/3163/2912/files/visa.png?v=1" alt="Visa" class="footer__payment-icon">
            <img src="https://cdn.shopify.com/s/files/1/0558/3163/2912/files/amex.png?v=1" alt="American Express" class="footer__payment-icon">
            <img src="https://cdn.shopify.com/s/files/1/0558/3163/2912/files/mastercard.png?v=1" alt="Mastercard" class="footer__payment-icon">
            <img src="https://cdn.shopify.com/s/files/1/0558/3163/2912/files/discover.png?v=1" alt="Discover" class="footer__payment-icon">
            <img src="https://cdn.shopify.com/s/files/1/0558/3163/2912/files/paypal.png?v=1" alt="PayPal" class="footer__payment-icon">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  /* Info section */
  .footer-info-section {
    background: #fff;
    padding: 4rem 0;
    border-top: 1px solid #e0e0e0;
  }
  .footer-info__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }
  .footer-info__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1.5rem;
    color: #000;
  }
  .footer-info__content {
    color: #555;
    line-height: 1.8;
    font-size: 0.95rem;
  }
  .footer-info__content p {
    margin: 0 0 1.2rem;
  }
  .footer-info__content p:last-child {
    margin-bottom: 0;
  }

  /* Features section */
  .footer-features-section {
    background: #4a1c40;
    padding: 2.5rem 0;
  }
  .footer-features__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }
  .footer-features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .footer-feature {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: #fff;
  }
  .footer-feature__icon {
    flex-shrink: 0;
    color: #fff;
    opacity: 0.9;
  }
  .footer-feature__content h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.3rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .footer-feature__content p {
    font-size: 0.85rem;
    margin: 0;
    opacity: 0.85;
    font-style: italic;
  }

  /* Newsletter section */
  .footer-newsletter-section {
    background: linear-gradient(135deg, #4a1c40 0%, #3a1530 100%);
    padding: 3rem 0;
  }
  .footer-newsletter__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
    text-align: center;
  }
  .footer-newsletter__heading {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 2rem;
    color: #fff;
  }
  .footer-newsletter__form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    gap: 0;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }
  .footer-newsletter__input {
    flex: 1;
    padding: 1rem 1.5rem;
    border: none;
    background: #fff;
    color: #333;
    font-size: 0.95rem;
    outline: none;
  }
  .footer-newsletter__input::placeholder {
    color: #999;
  }
  .footer-newsletter__button {
    padding: 1rem 2.5rem;
    background: #4a1c40;
    color: #fff;
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .footer-newsletter__button:hover {
    background: #3a1530;
  }

  /* Main footer */
  .site-footer {
    background: #2c1a29;
    color: #fff;
  }
  .footer__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }
  .footer__main {
    padding: 3rem 0 2rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .footer__column--about {
    max-width: 350px;
  }
  .footer__heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #fff;
  }
  .footer__text {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }
  .footer__text p {
    margin: 0 0 0.8rem;
  }
  .footer__text p:last-child {
    margin-bottom: 0;
  }
  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer__links li {
    margin-bottom: 0.6rem;
  }
  .footer__links a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s;
    display: inline-block;
  }
  .footer__links a:hover {
    color: #fff;
  }
  .footer__contact {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }
  .footer__contact p {
    margin: 0 0 0.5rem;
  }
  .footer__contact strong {
    color: #fff;
    display: block;
    margin-bottom: 0.3rem;
  }
  .footer__contact a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer__contact a:hover {
    color: #fff;
  }
  .footer__bottom {
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer__bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer__copyright {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .footer__payment {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .footer__payment-icon {
    height: 32px;
    width: auto;
    background: #fff;
    padding: 4px 8px;
    border-radius: 4px;
    opacity: 0.9;
    transition: opacity 0.3s;
  }
  .footer__payment-icon:hover {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .footer-info__title {
      font-size: 1.5rem;
    }
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer-features__grid {
      grid-template-columns: 1fr;
    }
    .footer__bottom-content {
      flex-direction: column;
      text-align: center;
    }
    .footer-newsletter__form {
      flex-direction: column;
    }
    .footer-newsletter__heading {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
