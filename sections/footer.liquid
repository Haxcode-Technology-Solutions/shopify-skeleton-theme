<footer class="site-footer">

  <div class="footer__middle">
    <div class="footer__container">
      <div class="footer__features">
        <div class="footer__feature">
          <div class="footer__feature-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2"/>
              <path d="M15 20l5 5 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="footer__feature-text">
            <strong>900+ BRANDS</strong>
            <p>All types of Products</p>
          </div>
        </div>

        <div class="footer__feature">
          <div class="footer__feature-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <path d="M5 20h30M20 5v30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <circle cx="20" cy="20" r="15" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <div class="footer__feature-text">
            <strong>USA & CANADA SHIPPING</strong>
            <p>Next Day & Priority plus Fast Shipping</p>
          </div>
        </div>

        <div class="footer__feature">
          <div class="footer__feature-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2"/>
              <path d="M20 10v10l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="footer__feature-text">
            <strong>CUSTOMER SERVICE</strong>
            <p>Call , Text, Toll Free & Help Center</p>
          </div>
        </div>

        <div class="footer__feature">
          <div class="footer__feature-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <rect x="5" y="10" width="30" height="20" rx="2" stroke="currentColor" stroke-width="2"/>
              <path d="M5 15h30" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <div class="footer__feature-text">
            <strong>100% SECURED PAYMENT</strong>
            <p>We never use your card details</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% if section.settings.show_newsletter %}
    <div class="footer__newsletter">
      <div class="footer__container">
        <div class="footer__newsletter-content">
          <div class="footer__newsletter-info">
            <h3 class="footer__newsletter-heading">{{ section.settings.newsletter_heading | default: "Be the first to save!" }}</h3>
            <p class="footer__newsletter-text">{{ section.settings.newsletter_text | default: "Enter your email below to get attractive offers." }}</p>
          </div>
          <form action="{{ routes.root_url }}contact" method="post" class="footer__newsletter-form">
            <input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required aria-label="Email address">
            <button type="submit">SUBSCRIBE</button>
          </form>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="footer__top">
    <div class="footer__container">
      <div class="footer__grid">
        <div class="footer__column footer__column--about">
          <h3 class="footer__heading">About Us</h3>
          <p class="footer__text">
            {{ section.settings.about_text | default: "Best of Fragrances is has been America's #1 global trusted retail online shop for perfumes and colognes since 2011. We stock more than 11,000 women's and men's fragrances…" }}
          </p>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">{{ section.settings.column_1_heading | default: "bestoffragrances.com" }}</h3>
          <ul class="footer__links">
            {% if section.settings.menu_1 != blank %}
              {% for link in section.settings.menu_1.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/privacy-policy">Privacy and Terms</a></li>
              <li><a href="/pages/refund-policy">Return & Refund Policy</a></li>
              <li><a href="/pages/bulk-order">Bulk Order</a></li>
              <li><a href="/pages/sell-with-us">Sell with us</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">Customer Service</h3>
          <ul class="footer__links">
            {% if section.settings.menu_2 != blank %}
              {% for link in section.settings.menu_2.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/about-us">About Us</a></li>
              <li><a href="/pages/faq">FAQ & Testimonial</a></li>
              <li><a href="/pages/privacy-policy">Privacy Details</a></li>
              <li><a href="/pages/discount-coupons">Discount Coupons</a></li>
              <li><a href="/pages/shipping-info">Shipping Information</a></li>
              <li><a href="/pages/contact-us">Contact Us</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">In the spotlight</h3>
          <ul class="footer__links">
            {% if section.settings.menu_3 != blank %}
              {% for link in section.settings.menu_3.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/pure-perfume">Pure Perfume</a></li>
              <li><a href="/collections/body-wash">Body Wash</a></li>
              <li><a href="/collections/skin-care">Skin Care</a></li>
              <li><a href="/collections/gift-sets">Gift Set</a></li>
              <li><a href="/collections/all">All Brands</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer__column">
          <h3 class="footer__heading">Contact Us</h3>
          <div class="footer__contact">
            {% if section.settings.address != blank %}
              <p>
                <strong>{{ section.settings.address }}</strong>
              </p>
            {% endif %}
            {% if section.settings.email != blank %}
              <p>Email: <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
            {% endif %}
            {% if section.settings.phone != blank %}
              <p>Phone: <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a></p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="footer__bottom">
    <div class="footer__container">
      <div class="footer__bottom-content">
        <div class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: "Best of Fragrances for the World" }} {{ shop.name }}
        </div>

        {% if section.settings.show_payment_icons %}
          <div class="footer__payment">
            <span class="footer__payment-label">We Accept:</span>
            <div class="footer__payment-icons">
              {% if shop.enabled_payment_types.size > 0 %}
                {% for type in shop.enabled_payment_types %}
                  {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
                {% endfor %}
              {% else %}
                {%comment%} Fallback payment icons if no payment types are enabled {%endcomment%}
                <svg class="footer__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="pi-visa"><title id="pi-visa">Visa</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path d="M28.3 10.1H28c-.4 1-.7 1.5-1 3h1.9c-.3-1.5-.3-2.2-.6-3zm2.9 5.9h-1.7c-.1 0-.1 0-.2-.1l-.2-.9-.1-.2h-2.4c-.1 0-.2 0-.2.2l-.3.9c0 .1-.1.1-.1.1h-2.1l.2-.5L27 8.7c0-.5.3-.7.8-.7h1.5c.1 0 .2 0 .2.2l1.4 6.5c.1.4.2.7.2 1.1.1.1.1.1.1.2zm-13.4-.3l.4-1.8c.1 0 .2.1.2.1.7.3 1.4.5 2.1.4.2 0 .5-.1.7-.2.5-.2.5-.7.1-1.1-.2-.2-.5-.3-.8-.5-.4-.2-.8-.4-1.1-.7-1.2-1-.8-2.4-.1-3.1.6-.4.9-.8 1.7-.8 1.2 0 2.5 0 3.1.2h.1c-.1.6-.2 1.1-.4 1.7-.5-.2-1-.4-1.5-.4-.3 0-.6 0-.9.1-.2 0-.3.1-.4.2-.2.2-.2.5 0 .7l.5.4c.4.2.8.4 1.1.6.5.3 1 .8 1.1 1.4.2.9-.1 1.7-.9 2.3-.5.4-.7.6-1.4.6-1.4 0-2.5.1-3.4-.2-.1.2-.1.2-.2.1zm-3.5.3c.1-.7.1-.7.2-1 .5-2.2 1-4.5 1.4-6.7.1-.2.1-.3.3-.3H18c-.2 1.2-.4 2.1-.7 3.2-.3 1.5-.6 3-1 4.5 0 .2-.1.2-.3.2M5 8.2c0-.1.2-.2.3-.2h3.4c.5 0 .9.3 1 .8l.9 4.4c0 .1 0 .1.1.2 0-.1.1-.1.1-.1l2.1-5.1c-.1-.1 0-.2.1-.2h2.1c0 .1 0 .1-.1.2l-3.1 7.3c-.1.2-.1.3-.2.4-.1.1-.3 0-.5 0H9.7c-.1 0-.2 0-.2-.2L7.9 9.5c-.2-.2-.5-.5-.9-.6-.6-.3-1.7-.5-1.9-.5L5 8.2z" fill="#142688"/></svg>
                <svg class="footer__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="pi-master"><title id="pi-master">Mastercard</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><circle fill="#EB001B" cx="15" cy="12" r="7"/><circle fill="#F79E1B" cx="23" cy="12" r="7"/><path fill="#FF5F00" d="M22 12c0-2.4-1.2-4.5-3-5.7-1.8 1.3-3 3.4-3 5.7s1.2 4.5 3 5.7c1.8-1.2 3-3.3 3-5.7z"/></svg>
                <svg class="footer__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="pi-american_express"><title id="pi-american_express">American Express</title><path fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z" opacity=".07"/><path fill="#006FCF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32Z"/><path fill="#FFF" d="M22.012 19.936v-8.421L37 11.528v2.326l-1.732 1.852L37 17.573v2.375h-2.766l-1.47-1.622-1.46 1.628-9.292-.02Z"/><path fill="#006FCF" d="M23.013 19.012v-6.57h5.572v1.513h-3.768v1.028h3.678v1.488h-3.678v1.01h3.768v1.531h-5.572Z"/><path fill="#006FCF" d="m28.557 19.012 3.083-3.289-3.083-3.282h2.386l1.884 2.083 1.89-2.083H37v.051l-3.017 3.23L37 18.92v.093h-2.307l-1.917-2.103-1.898 2.104h-2.321Z"/><path fill="#FFF" d="M22.71 4.04h3.614l1.269 2.881V4.04h4.46l.77 2.159.771-2.159H37v8.421H19l3.71-8.421Z"/><path fill="#006FCF" d="m23.395 4.955-2.916 6.566h2l.55-1.315h2.98l.55 1.315h2.05l-2.904-6.566h-2.31Zm.25 3.777.875-2.09.873 2.09h-1.748Z"/><path fill="#006FCF" d="M28.581 11.52V4.953l2.811.01L32.84 9l1.456-4.046H37v6.565l-1.74.016v-4.51l-1.644 4.494h-1.59L30.35 7.01v4.51h-1.768Z"/></svg>
                <svg class="footer__payment-icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="pi-paypal"><title id="pi-paypal">PayPal</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#003087" d="M23.9 8.3c.2-1 0-1.7-.6-2.3-.6-.7-1.7-1-3.1-1h-4.1c-.3 0-.5.2-.6.5L14 15.6c0 .2.1.4.3.4H17l.4-3.4 1.8-2.2 4.7-2.1z"/><path fill="#3086C8" d="M23.9 8.3l-.2.2c-.5 2.8-2.2 3.8-4.6 3.8H18c-.3 0-.5.2-.6.5l-.6 3.9-.2 1c0 .2.1.4.3.4H19c.3 0 .5-.2.5-.4v-.1l.4-2.4v-.1c0-.2.3-.4.5-.4h.3c2.1 0 3.7-.8 4.1-3.2.2-1 .1-1.8-.4-2.4-.1-.5-.3-.7-.5-.8z"/><path fill="#012169" d="M23.3 8.1c-.1-.1-.2-.1-.3-.1-.1 0-.2 0-.3-.1-.3-.1-.7-.1-1.1-.1h-3c-.1 0-.2 0-.2.1-.2.1-.3.2-.3.4l-.7 4.4v.1c0-.3.3-.5.6-.5h1.3c2.5 0 4.1-1 4.6-3.8v-.2c-.1-.1-.3-.2-.5-.2h-.1z"/></svg>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
