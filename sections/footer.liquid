    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Column 1 heading",
      "default": "bestoffragrances.com"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Customer Service menu"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Spotlight menu"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "Best of Fragrances, By Niralco LLC,"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Store address",
      "default": "2880 Cochran Street #1024, Simi Valley, CA 93065"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@example.com"
