{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<h1>{{ 'collections.title' | t }}</h1>
<!-- ===== COLLECTIONS SEARCH HERO ===== -->
<div class="collections-hero">
  <div class="collections-hero__inner">
    <p class="collections-hero__eyebrow">Explore Our World</p>
    <h1 class="collections-hero__title">Find Your Signature Scent</h1>
    <p class="collections-hero__subtitle">
      Browse over 300+ fragrance brands — from timeless classics to hidden gems.
    </p>

    <div class="collections-search">
      <div class="collections-search__wrapper">
        <svg class="collections-search__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="collectionSearch"
          class="collections-search__input"
          type="text"
          placeholder="Search brands — Chanel, Dior, Creed…"
          autocomplete="off"
          spellcheck="false"
        />
        <button class="collections-search__clear" id="clearSearch" aria-label="Clear search" hidden>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="collections-search__meta" id="searchMeta" hidden>
        <span id="searchCount"></span>
      </div>
    </div>

    <div class="collections-hero__stats">
      <div class="collections-hero__stat"><span class="stat-number" id="totalCount">300+</span><span class="stat-label">Brands</span></div>
      <div class="collections-hero__divider"></div>
      <div class="collections-hero__stat"><span class="stat-number">7000+</span><span class="stat-label">Products</span></div>
      <div class="collections-hero__divider"></div>
      <div class="collections-hero__stat"><span class="stat-number">Free</span><span class="stat-label">Shipping*</span></div>
    </div>
  </div>
</div>

<!-- ===== NO RESULTS MESSAGE (inject just before .collections--full) ===== -->
<div class="collections-no-results" id="noResults" hidden>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="#4a1c40" stroke-width="2">
    <circle cx="28" cy="28" r="18"/><line x1="42" y1="42" x2="58" y2="58"/>
    <line x1="22" y1="28" x2="34" y2="28"/><line x1="28" y1="22" x2="28" y2="34"/>
  </svg>
  <h3>No brands found</h3>
  <p>Try a different spelling or a shorter search term.</p>
  <button class="collections-no-results__btn" id="resetSearch">Show all brands</button>
</div>
<div
  class="collections {{ section.settings.grid_item_width }}"
  style="--grid-gap: {{ section.settings.grid_gap }}px"
>
  {% for collection in collections %}
    {% if collection.products_count > 5 %} 
      <a class="collection-card" href="{{ collection.url }}" title="{{ collection.title }}">
        {% if collection.featured_image %}
          {% render 'image',
            class: 'collection-card__image',
            image: collection.featured_image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        {% endif %}

        <div class="collection-card__content">
          <p>{{ collection.title }}</p>

          {% if collection.description %}
            <p>{{ collection.description | strip_html | truncatewords: 15 }}</p>
          {% endif %}
        </div>
      </a>
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--collection-card-size), 100%), 1fr));
    gap: var(--grid-gap);
  }
  .collections--compact {
    --collection-card-size: 160px;
  }
  .collections--full {
    --collection-card-size: 280px;
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* ============================================================
   BEST OF FRAGRANCES — Collections Page Redesign
   Targets: .collections--full, .collection-card, H1, section
   Brand color: #4a1c40 (plum) · Font: Work Sans
   ============================================================ */

  /* ── Reset & page background ── */
  #shopify-section-template--20801976008933__collections_mktb3n {
    background: #f9f6f8;
    padding: 0 0 60px;
  }

  /* ── Page heading ── */
  #shopify-section-template--20801976008933__collections_mktb3n > h1 {
    display: none; /* hidden — replaced by the search hero below */
  }

  /* ── Collections grid ── */
  .collections.collections--full {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)) !important;
    gap: 24px !important;
    padding: 0 24px !important;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Card ── */
  .collection-card {
    position: relative;
    display: flex !important;
    flex-direction: column !important;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit !important;
    box-shadow: 0 2px 12px rgba(74, 28, 64, 0.07);
    transition: transform 0.3s cubic-bezier(.22,.68,0,1.2),
                box-shadow 0.3s ease;
    border: 1px solid rgba(74, 28, 64, 0.06);
  }

  .collection-card:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow: 0 16px 40px rgba(74, 28, 64, 0.18);
  }

  /* ── Card image wrapper ── */
  .collection-card__image.image {
    width: 100%;
    height: 220px !important;
    overflow: hidden;
    background: linear-gradient(135deg, #f5eef8 0%, #ede0f0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .collection-card__image.image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, rgba(74,28,64,0.08) 100%);
    pointer-events: none;
  }

  .collection-card__image.image img {
    width: 100%;
    height: 100%;
    object-fit: cover !important;
    object-position: center top;
    transition: transform 0.5s ease;
  }

  .collection-card:hover .collection-card__image.image img {
    transform: scale(1.06);
  }

  /* ── Card content ── */
  .collection-card__content {
    padding: 16px 18px 18px !important;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    border-top: 2px solid transparent;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(135deg, #4a1c40, #c97ab2) border-box;
    border-radius: 0 0 16px 16px;
  }

  /* Title (first <p> inside content) */
  .collection-card__content p:first-child {
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    color: #2d0a28 !important;
    margin: 0 !important;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  /* Description (second <p> inside content) */
  .collection-card__content p:last-child {
    font-size: 0.78rem !important;
    color: #888 !important;
    margin: 0 !important;
    line-height: 1.5;
    font-weight: 400;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Hidden cards (filtered out by search) ── */
  .collection-card[data-hidden="true"] {
    display: none !important;
  }

  /* ── No-results message ── */
  #bof-no-results {
    display: none;
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 1.1rem;
    grid-column: 1 / -1;
  }
  #bof-no-results.visible {
    display: block;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .collections.collections--full {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)) !important;
      gap: 16px !important;
      padding: 0 16px !important;
    }
    .collection-card__image.image {
      height: 160px !important;
    }
  }

  @media (max-width: 480px) {
    .collections.collections--full {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  /* ==========================================
    COLLECTIONS HERO & SEARCH
    ========================================== */

  :root {
    --brand: #4a1c40;
    --brand-light: #6b2d5e;
    --brand-xlight: rgba(74, 28, 64, 0.08);
    --brand-border: rgba(74, 28, 64, 0.14);
    --text-dark: #1a1a1a;
    --text-mid: #555;
    --text-muted: #888;
    --white: #ffffff;
    --radius-card: 16px;
    --radius-search: 50px;
    --font: "Work Sans", sans-serif;
    --shadow-soft: 0 4px 24px rgba(74, 28, 64, 0.10);
    --shadow-focus: 0 0 0 3px rgba(74, 28, 64, 0.18);
    --transition: 0.22s ease;
  }

  /* ----- Hero ----- */
  .collections-hero {
    background: linear-gradient(135deg, #faf7f9 0%, #f3eaf1 50%, #ede0ea 100%);
    border-bottom: 1px solid var(--brand-border);
    padding: 64px 24px 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .collections-hero::before {
    content: "";
    position: absolute;
    top: -80px; right: -80px;
    width: 340px; height: 340px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(74,28,64,0.07) 0%, transparent 70%);
    pointer-events: none;
  }
  .collections-hero::after {
    content: "";
    position: absolute;
    bottom: -60px; left: -60px;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(74,28,64,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .collections-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }

  .collections-hero__eyebrow {
    font-family: var(--font);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
    margin: 0 0 16px;
    opacity: 0.85;
  }

  .collections-hero__title {
    font-family: var(--font);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.18;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }

  .collections-hero__subtitle {
    font-family: var(--font);
    font-size: 16px;
    color: var(--text-mid);
    margin: 0 0 36px;
    line-height: 1.6;
  }

  /* ----- Search Bar ----- */
  .collections-search {
    margin-bottom: 36px;
  }

  .collections-search__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--white);
    border: 1.5px solid var(--brand-border);
    border-radius: var(--radius-search);
    box-shadow: var(--shadow-soft);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .collections-search__wrapper:focus-within {
    border-color: var(--brand);
    box-shadow: var(--shadow-focus), var(--shadow-soft);
  }

  .collections-search__icon {
    width: 18px; height: 18px;
    flex-shrink: 0;
    margin-left: 20px;
    color: var(--brand);
    pointer-events: none;
    transition: color var(--transition);
  }

  .collections-search__input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font);
    font-size: 15px;
    color: var(--text-dark);
    padding: 16px 14px 16px 12px;
    width: 100%;
  }

  .collections-search__input::placeholder {
    color: #aaa;
  }

  .collections-search__clear {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-xlight);
    border: none;
    border-radius: 50%;
    width: 28px; height: 28px;
    margin-right: 14px;
    cursor: pointer;
    color: var(--brand);
    flex-shrink: 0;
    transition: background var(--transition), transform var(--transition);
  }

  .collections-search__clear:hover {
    background: rgba(74, 28, 64, 0.16);
    transform: scale(1.1);
  }

  .collections-search__clear svg {
    width: 13px; height: 13px;
  }

  .collections-search__meta {
    margin-top: 10px;
    font-family: var(--font);
    font-size: 13px;
    color: var(--text-muted);
  }

  #searchCount strong {
    color: var(--brand);
    font-weight: 600;
  }

  /* ----- Stats Strip ----- */
  .collections-hero__stats {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    background: var(--brand);
    border: 1px solid var(--brand-border);
    border-radius: 40px;
    padding: 12px 28px;
    box-shadow: 0 2px 12px rgba(74,28,64,0.07);
  }

  .collections-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
  }

  .stat-number {
    font-family: var(--font);
    font-size: 16px;
    font-weight: 700;
    color: var(--brand);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .collections-hero__divider {
    width: 1px;
    height: 28px;
    background: var(--brand-border);
  }

  /* ----- No Results ----- */
  .collections-no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 72px 24px;
    text-align: center;
    gap: 12px;
  }

  .collections-no-results svg {
    width: 56px; height: 56px;
    opacity: 0.4;
    margin-bottom: 4px;
  }

  .collections-no-results h3 {
    font-family: var(--font);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-dark);
    margin: 0;
  }

  .collections-no-results p {
    font-family: var(--font);
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }

  .collections-no-results__btn {
    margin-top: 8px;
    background: var(--brand);
    color: var(--white);
    border: none;
    border-radius: 40px;
    padding: 10px 24px;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }

  .collections-no-results__btn:hover {
    background: var(--brand-light);
    transform: translateY(-1px);
  }

  /* ----- Card hide/show animation ----- */
  .collection-card.is-hidden {
    display: none !important;
  }

  .collection-card {
    transition: opacity 0.18s ease;
  }

  /* ----- Responsive ----- */
  @media (max-width: 600px) {
    .collections-hero {
      padding: 48px 16px 40px;
    }
    .collections-hero__stats {
      gap: 16px;
      padding: 10px 20px;
    }
  }
{% endstylesheet %}


{% javascript %}
(function () {
  const input     = document.getElementById('collectionSearch');
  const clearBtn  = document.getElementById('clearSearch');
  const noResults = document.getElementById('noResults');
  const resetBtn  = document.getElementById('resetSearch');
  const metaBox   = document.getElementById('searchMeta');
  const countEl   = document.getElementById('searchCount');
  const totalEl   = document.getElementById('totalCount');

  const cards = Array.from(document.querySelectorAll('.collection-card'));

  // Update hero stat with real count
  // if (totalEl) totalEl.textContent = cards.length;

  // Always hide no-results on init
  if (noResults) {
    noResults.hidden = true;
    noResults.style.display = "none";
  }

  // Debounce utility
  function debounce(fn, ms) {
    let timer;
    return function (...args) {
      clearTimeout(timer);
      timer = setTimeout(() => fn.apply(this, args), ms);
    };
  }

  function filterCards(query) {
    const q = query.trim().toLowerCase();

    // Cleared — show everything, hide UI chrome
    if (!q) {
      cards.forEach(c => c.classList.remove('is-hidden'));
      if (noResults) {
        noResults.hidden = true;
        noResults.style.display = "none";
      }
      metaBox.hidden  = true;
      clearBtn.hidden = true;
      return;
    }

    clearBtn.hidden = false;

    let visible = 0;
    cards.forEach(card => {
      // Use the title attribute on the <a> tag for matching
      const label = (card.getAttribute('title') || '').toLowerCase();
      const match = label.includes(q);
      card.classList.toggle('is-hidden', !match);
      if (match) visible++;
    });

    // Result count
    countEl.innerHTML = `<strong>${visible}</strong> brand${visible !== 1 ? 's' : ''} found`;
    metaBox.hidden = false;

    // No-results state
    if (noResults) {
      noResults.hidden = visible > 0;
      noResults.style.display = (visible > 0) ? "none" : "block";
    }
  }

  input.addEventListener('input', debounce(function () {
    filterCards(this.value);
  }, 180));

  clearBtn.addEventListener('click', function () {
    input.value = '';
    filterCards('');
    input.focus();
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      input.value = '';
      filterCards('');
      input.focus();
    });
  }

  // Press '/' anywhere to focus the search
  document.addEventListener('keydown', function (e) {
    if (e.key === '/' && document.activeElement !== input) {
      e.preventDefault();
      input.focus();
      input.select();
    }
  });
})();
{% endjavascript %}






{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
