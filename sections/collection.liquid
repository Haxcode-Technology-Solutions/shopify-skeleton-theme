{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection-page">
  <div class="collection-header">
    <div class="container">
      <h1 class="collection-header__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-header__description">{{ collection.description }}</div>
      {% endif %}
      <div class="collection-header__meta">
        <span class="collection-header__count">{{ collection.products_count }} products</span>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="collection-toolbar">
      <button id="filterToggle" class="filter-toggle">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor">
          <path d="M3 6h14M6 10h8M8 14h4" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Filters
      </button>
      <div class="collection-toolbar__sort">
        <label for="sortBy">Sort by:</label>
        <select id="sortBy">
          <option value="manual">Featured</option>
          <option value="best-selling">Best Selling</option>
          <option value="title-ascending">A-Z</option>
          <option value="title-descending">Z-A</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="created-descending">Newest</option>
        </select>
      </div>
    </div>

    <div class="collection-content">
      <aside id="filterSidebar" class="collection-filters">
        <div class="collection-filters__header">
          <h3>Filters</h3>
          <button id="filterClose" class="filter-close">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor">
              <path d="M15 5L5 15M5 5l10 10" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="filter-group">
          <h4 class="filter-group__title">Price Range</h4>
          <div class="filter-price-slider">
            <div class="price-slider__values">
              <span class="price-slider__value" id="priceMinValue">$0</span>
              <span class="price-slider__separator">-</span>
              <span class="price-slider__value" id="priceMaxValue">$500</span>
            </div>
            <div class="price-slider__container">
              <div class="price-slider__track"></div>
              <div class="price-slider__range" id="priceSliderRange"></div>
              <input type="range" id="priceMin" class="price-slider__input price-slider__input--min" min="0" max="500" value="0" step="10">
              <input type="range" id="priceMax" class="price-slider__input price-slider__input--max" min="0" max="500" value="500" step="10">
            </div>
          </div>
        </div>

        <div class="filter-group">
          <h4 class="filter-group__title">Availability</h4>
          <label class="filter-checkbox">
            <input type="checkbox" class="filter-checkbox__input" data-filter-type="availability" value="in-stock">
            <span class="filter-checkbox__label">In Stock</span>
          </label>
          <label class="filter-checkbox">
            <input type="checkbox" class="filter-checkbox__input" data-filter-type="availability" value="out-of-stock">
            <span class="filter-checkbox__label">Out of Stock</span>
          </label>
        </div>

        {% assign vendors = collection.products | map: 'vendor' | uniq %}
        {% if vendors.size > 0 %}
          <div class="filter-group">
            <h4 class="filter-group__title">Brand</h4>
            {% for vendor in vendors %}
              {% if vendor != blank %}
                <label class="filter-checkbox">
                  <input type="checkbox" class="filter-checkbox__input" data-filter-type="vendor" value="{{ vendor | escape }}">
                  <span class="filter-checkbox__label">{{ vendor }}</span>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign types = collection.products | map: 'type' | uniq %}
        {% if types.size > 0 %}
          <div class="filter-group">
            <h4 class="filter-group__title">Product Type</h4>
            {% for type in types %}
              {% if type != blank %}
                <label class="filter-checkbox">
                  <input type="checkbox" class="filter-checkbox__input" data-filter-type="type" value="{{ type | escape }}">
                  <span class="filter-checkbox__label">{{ type }}</span>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign all_tags = collection.products | map: 'tags' | join: ',' | split: ',' | uniq %}
        {% if all_tags.size > 0 %}
          <div class="filter-group">
            <h4 class="filter-group__title">Tags</h4>
            {% for tag in all_tags limit: 10 %}
              {% if tag != blank %}
                <label class="filter-checkbox">
                  <input type="checkbox" class="filter-checkbox__input" data-filter-type="tag" value="{{ tag | strip | escape }}">
                  <span class="filter-checkbox__label">{{ tag | strip }}</span>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <button id="clearFilters" class="filter-clear-btn">Clear All Filters</button>
      </aside>

      <div class="collection-products">
        {% paginate collection.products by 24 %}
          <div class="collection-products__grid">
            {% for product in collection.products %}
              <div class="product-card"
                   data-price="{{ product.price }}"
                   data-vendor="{{ product.vendor | escape }}"
                   data-type="{{ product.type | escape }}"
                   data-available="{{ product.available }}"
                   data-tags="{{ product.tags | join: ',' }}">
              <div class="product-card__image-wrapper">
                <a href="{{ product.url }}" class="product-card__image-link">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy', class: 'product-card__image' }}
                  {% else %}
                    <div class="product-card__placeholder"></div>
                  {% endif %}
                  {% if product.images[1] %}
                    {{ product.images[1] | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy', class: 'product-card__image product-card__image--hover' }}
                  {% endif %}
                </a>
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__badge product-card__badge--sale">Sale</span>
                {% endif %}
                {% unless product.available %}
                  <span class="product-card__badge product-card__badge--soldout">Sold Out</span>
                {% endunless %}
                <button class="product-card__wishlist" aria-label="Add to wishlist">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                    <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" stroke-width="2"/>
                  </svg>
                </button>
              </div>
              <div class="product-card__info">
                <div class="product-card__price">
                  <span class="product-card__price-left">
                    {% if product.vendor != blank %}
                      <p class="product-card__vendor">{{ product.vendor }}</p>
                    {% endif %}
                  </span>
                  <span class="product-card__price-right">
                    {% if product.compare_at_price > product.price %}
                      <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="product-card__price--current">{{ product.price | money }}</span>
                  </span>
                </div>
                <h3 class="product-card__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                
                <button class="product-card__button" data-product-id="{{ product.selected_or_first_available_variant.id }}">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                    <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 5m12-5l2 5m-12 0h12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  Add to Cart
                </button>
              </div>
            </div>
          {% endfor %}
        </div>

          {% if paginate.pages > 1 %}
            <div class="collection-pagination">
              {{ paginate | default_pagination }}
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</div>


{% javascript %}
  class CollectionPage {
    constructor() {
      this.filterToggle = document.getElementById('filterToggle');
      this.filterSidebar = document.getElementById('filterSidebar');
      this.filterClose = document.getElementById('filterClose');
      this.sortSelect = document.getElementById('sortBy');
      this.clearFiltersBtn = document.getElementById('clearFilters');
      this.priceMinInput = document.getElementById('priceMin');
      this.priceMaxInput = document.getElementById('priceMax');
      this.priceMinValue = document.getElementById('priceMinValue');
      this.priceMaxValue = document.getElementById('priceMaxValue');
      this.priceSliderRange = document.getElementById('priceSliderRange');
      this.filterCheckboxes = document.querySelectorAll('.filter-checkbox__input');
      this.productCards = document.querySelectorAll('.product-card');
      this.addToCartBtns = document.querySelectorAll('.product-card__button');

      this.init();
    }

    init() {
      if (this.filterToggle) {
        this.filterToggle.addEventListener('click', () => this.toggleSidebar());
      }

      if (this.filterClose) {
        this.filterClose.addEventListener('click', () => this.toggleSidebar());
      }

      if (this.sortSelect) {
        this.sortSelect.addEventListener('change', (e) => this.handleSort(e.target.value));
      }

      if (this.clearFiltersBtn) {
        this.clearFiltersBtn.addEventListener('click', () => this.clearFilters());
      }

      // Initialize price slider
      if (this.priceMinInput && this.priceMaxInput) {
        this.priceMinInput.addEventListener('input', () => this.updatePriceSlider());
        this.priceMaxInput.addEventListener('input', () => this.updatePriceSlider());
        this.updatePriceSlider();
      }

      this.filterCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => this.applyFilters());
      });

      this.addToCartBtns.forEach(btn => {
        if (!btn.disabled) {
          btn.addEventListener('click', (e) => this.addToCart(e));
        }
      });

      // Close sidebar when clicking outside
      document.addEventListener('click', (e) => {
        if (window.innerWidth <= 1024 &&
            this.filterSidebar.classList.contains('active') &&
            !this.filterSidebar.contains(e.target) &&
            !this.filterToggle.contains(e.target)) {
          this.toggleSidebar();
        }
      });

      // Get sort param from URL
      const urlParams = new URLSearchParams(window.location.search);
      const sortValue = urlParams.get('sort_by');
      if (sortValue && this.sortSelect) {
        this.sortSelect.value = sortValue;
      }
    }

    updatePriceSlider() {
      const minVal = parseInt(this.priceMinInput.value);
      const maxVal = parseInt(this.priceMaxInput.value);
      const min = parseInt(this.priceMinInput.min);
      const max = parseInt(this.priceMinInput.max);

      // Prevent min from exceeding max
      if (minVal > maxVal - 10) {
        this.priceMinInput.value = maxVal - 10;
      }

      // Prevent max from going below min
      if (maxVal < minVal + 10) {
        this.priceMaxInput.value = minVal + 10;
      }

      const actualMin = parseInt(this.priceMinInput.value);
      const actualMax = parseInt(this.priceMaxInput.value);

      // Update displayed values
      this.priceMinValue.textContent = `$${actualMin}`;
      this.priceMaxValue.textContent = `$${actualMax}`;

      // Update slider range visual
      const percentMin = ((actualMin - min) / (max - min)) * 100;
      const percentMax = ((actualMax - min) / (max - min)) * 100;

      this.priceSliderRange.style.left = percentMin + '%';
      this.priceSliderRange.style.width = (percentMax - percentMin) + '%';

      // Apply filters
      this.applyFilters();
    }

    toggleSidebar() {
      this.filterSidebar.classList.toggle('active');
    }

    handleSort(sortValue) {
      const url = new URL(window.location.href);
      url.searchParams.set('sort_by', sortValue);
      window.location.href = url.toString();
    }

    applyFilters() {
      const priceFrom = parseInt(this.priceMinInput.value) || 0;
      const priceTo = parseInt(this.priceMaxInput.value) || Infinity;

      const selectedVendors = Array.from(document.querySelectorAll('.filter-checkbox__input[data-filter-type="vendor"]:checked'))
        .map(cb => cb.value);
      const selectedTypes = Array.from(document.querySelectorAll('.filter-checkbox__input[data-filter-type="type"]:checked'))
        .map(cb => cb.value);
      const selectedTags = Array.from(document.querySelectorAll('.filter-checkbox__input[data-filter-type="tag"]:checked'))
        .map(cb => cb.value.trim());
      const selectedAvailability = Array.from(document.querySelectorAll('.filter-checkbox__input[data-filter-type="availability"]:checked'))
        .map(cb => cb.value);

      this.productCards.forEach(card => {
        const priceInCents = parseFloat(card.dataset.price);
        const price = priceInCents / 100; // Convert cents to dollars
        const vendor = card.dataset.vendor;
        const type = card.dataset.type;
        const available = card.dataset.available === 'true';
        const productTags = card.dataset.tags ? card.dataset.tags.split(',').map(t => t.trim()) : [];

        let show = true;

        // Price filter
        if (price < priceFrom || price > priceTo) {
          show = false;
        }

        // Vendor filter
        if (selectedVendors.length > 0 && !selectedVendors.includes(vendor)) {
          show = false;
        }

        // Type filter
        if (selectedTypes.length > 0 && !selectedTypes.includes(type)) {
          show = false;
        }

        // Tag filter
        if (selectedTags.length > 0) {
          const hasMatchingTag = selectedTags.some(tag => productTags.includes(tag));
          if (!hasMatchingTag) {
            show = false;
          }
        }

        // Availability filter
        if (selectedAvailability.length > 0) {
          const inStockSelected = selectedAvailability.includes('in-stock');
          const outOfStockSelected = selectedAvailability.includes('out-of-stock');

          if (inStockSelected && !outOfStockSelected && !available) {
            show = false;
          } else if (outOfStockSelected && !inStockSelected && available) {
            show = false;
          }
        }

        card.style.display = show ? 'flex' : 'none';
      });
    }

    clearFilters() {
      this.priceMinInput.value = this.priceMinInput.min;
      this.priceMaxInput.value = this.priceMaxInput.max;
      this.updatePriceSlider();
      this.filterCheckboxes.forEach(cb => cb.checked = false);
      this.productCards.forEach(card => card.style.display = 'flex');
    }

    async addToCart(e) {
      const btn = e.currentTarget;
      const productId = btn.dataset.productId;

      if (!productId) return;

      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: productId,
            quantity: 1
          })
        });

        if (response.ok) {
          btn.innerHTML = 'Added!';
          setTimeout(() => {
            btn.innerHTML = originalHTML;
            btn.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:updated'));
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
        btn.innerHTML = 'Error';
        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.disabled = false;
        }, 2000);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new CollectionPage();
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
