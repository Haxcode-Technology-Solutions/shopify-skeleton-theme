          "info": "CSS gradient syntax. Example: linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show text overlay",
          "default": true
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "THE NEW FRAGRANCE FOR MEN"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "BOSS HUGO BOSS BOTTLED"
        },
        {
          "type": "text",
          "id": "button_label",
