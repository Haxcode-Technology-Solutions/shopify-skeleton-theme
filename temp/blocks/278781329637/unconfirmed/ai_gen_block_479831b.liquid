{% doc %}
  @prompt
    banner slider with controls, and seperate mobile image
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-banner-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
  }

  .ai-banner-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .ai-banner-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    position: relative;
    display: flex;
    align-items: {{ block.settings.content_position_vertical }};
    justify-content: {{ block.settings.content_position_horizontal }};
  }

  .ai-banner-slider__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-banner-slider__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-banner-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-slider__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: 40px;
    max-width: {{ block.settings.content_max_width }}px;
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
  }

  .ai-banner-slider__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-banner-slider__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .ai-banner-slider__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-banner-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-banner-slider__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: background-color 0.3s ease;
    padding: 0;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }}--prev {
    left: 20px;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }}--next {
    right: 20px;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-banner-slider__mobile-image-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-slider__wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-banner-slider__image-{{ ai_gen_id }} {
      display: none;
    }

    .ai-banner-slider__mobile-image-{{ ai_gen_id }} {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ai-banner-slider__content-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-banner-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-banner-slider__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }}--prev {
      left: 10px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }}--next {
      right: 10px;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }} class="ai-banner-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-slider__wrapper-{{ ai_gen_id }}">
    <div class="ai-banner-slider__track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
          assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
          assign heading_key = 'slide_' | append: i | append: '_heading'
          assign text_key = 'slide_' | append: i | append: '_text'
          assign button_text_key = 'slide_' | append: i | append: '_button_text'
          assign button_link_key = 'slide_' | append: i | append: '_button_link'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign desktop_image = block.settings[desktop_image_key]
          assign mobile_image = block.settings[mobile_image_key]
          assign heading = block.settings[heading_key]
          assign text = block.settings[text_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}

        {% if slide_enabled %}
          <div class="ai-banner-slider__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            {% if desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 2000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-banner-slider__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-banner-slider__image-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if mobile_image %}
              <img
                src="{{ mobile_image | image_url: width: 1000 }}"
                alt="{{ mobile_image.alt | escape }}"
                loading="lazy"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
                class="ai-banner-slider__mobile-image-{{ ai_gen_id }}"
              >
            {% elsif desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 1000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-banner-slider__mobile-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-banner-slider__image-placeholder-{{ ai_gen_id }} ai-banner-slider__mobile-image-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-banner-slider__content-{{ ai_gen_id }}">
              {% if heading != blank %}
                <h2 class="ai-banner-slider__heading-{{ ai_gen_id }}">{{ heading }}</h2>
              {% endif %}

              {% if text != blank %}
                <div class="ai-banner-slider__text-{{ ai_gen_id }}">{{ text }}</div>
              {% endif %}

              {% if button_text != blank and button_link != blank %}
                <a href="{{ button_link }}" class="ai-banner-slider__button-{{ ai_gen_id }}">
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_arrows %}
      <button class="ai-banner-slider__arrow-{{ ai_gen_id }} ai-banner-slider__arrow-{{ ai_gen_id }}--prev" aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="ai-banner-slider__arrow-{{ ai_gen_id }} ai-banner-slider__arrow-{{ ai_gen_id }}--next" aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-banner-slider__controls-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-banner-slider__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-banner-slider__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-banner-slider__arrow-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-banner-slider__arrow-{{ ai_gen_id }}--next');
        this.dotsContainer = this.querySelector('.ai-banner-slider__controls-{{ ai_gen_id }}');
        this.autoplay = {{ block.settings.autoplay }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        if (this.slides.length === 0) return;

        this.createDots();
        this.setupEventListeners();
        this.goToSlide(0);

        if (this.autoplay && this.slides.length > 1) {
          this.startAutoplay();
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-banner-slider__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });

        this.dots = this.querySelectorAll('.ai-banner-slider__dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        let startX = 0;
        let endX = 0;

        this.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.addEventListener('touchend', (e) => {
          endX = e.changedTouches[0].clientX;
          if (startX - endX > 50) {
            this.nextSlide();
          } else if (endX - startX > 50) {
            this.previousSlide();
          }
        });

        if (this.autoplay) {
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        const offset = -100 * index;
        this.track.style.transform = `translateX(${offset}%)`;

        if (this.dots) {
          this.dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        if (this.autoplay) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        if (this.slides.length <= 1) return;
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('banner-slider-{{ ai_gen_id }}', BannerSlider{{ ai_gen_id }});
  })();
</script>

