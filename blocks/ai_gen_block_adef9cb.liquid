{% doc %}
  @prompt
    Create a fully responsive collection page section with the following features:
    1. Sidebar filters on the LEFT side on desktop — showing all available Shopify storefront filters (price range, availability, product type, vendor, tags, etc.) using Shopify's native filter API
    2. On mobile (below 768px), filters should be hidden by default and accessible via a "Filter & Sort" toggle button that opens a slide-in drawer overlay
    3. A responsive product grid: 1 column on small mobile, 2 columns on mobile/tablet, 3-4 columns on desktop
    4. A "Sort by" dropdown visible on both desktop and mobile
    5. Active filter pills/tags displayed above the product grid so users can see and remove applied filters
    6. Product count display (e.g., "24 products")
    7. Clean, premium aesthetic suitable for a luxury fragrance brand
    8. Fully accessible (ARIA labels, keyboard navigation for the mobile drawer)
    9. Use Shopify's native pagination or infinite scroll
    10. Compatible with Shopify OS 2.0 themes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ settings.max_page_width }};
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px {{ settings.min_page_margin }}px {{ block.settings.section_padding_bottom }}px;
    font-family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    position: relative;
  }

  .ai-collection-page__sidebar-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.sidebar_width }}px;
    position: sticky;
    top: 20px;
    height: fit-content;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
  }

  .ai-collection-page__main-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-collection-page__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .ai-collection-page__count-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_count_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-collection-page__sort-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-collection-page__sort-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__sort-select-{{ ai_gen_id }} {
    padding: 10px 16px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ settings.input_corner_radius }}px;
    background-color: {{ settings.background_color }};
    color: {{ settings.foreground_color }};
    font-size: 14px;
    cursor: pointer;
    min-width: 200px;
  }

  .ai-collection-page__mobile-toggle-{{ ai_gen_id }} {
    display: none;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ settings.input_corner_radius }}px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    align-items: center;
    gap: 8px;
  }

  .ai-collection-page__mobile-toggle-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-collection-page__active-filters-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: {{ block.settings.filters_spacing }}px;
  }

  .ai-collection-page__filter-pill-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background-color: {{ block.settings.pill_background }};
    color: {{ block.settings.pill_text_color }};
    border-radius: 20px;
    font-size: 13px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-collection-page__filter-pill-remove-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: {{ block.settings.pill_text_color }};
    opacity: 0.7;
    display: flex;
    align-items: center;
  }

  .ai-collection-page__filter-pill-remove-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-collection-page__clear-all-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 6px 12px;
    cursor: pointer;
    color: {{ block.settings.text_color }};
    text-decoration: underline;
    font-size: 13px;
  }

  .ai-collection-page__filters-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.filter_group_spacing }}px;
  }

  .ai-collection-page__filter-group-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
    padding-bottom: {{ block.settings.filter_group_spacing }}px;
  }

  .ai-collection-page__filter-group-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-collection-page__filter-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.filter_title_size }}px;
    font-weight: 600;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__filter-option-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .ai-collection-page__filter-checkbox-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-collection-page__filter-label-{{ ai_gen_id }} {
    font-size: 14px;
    cursor: pointer;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__filter-count-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin-left: 4px;
  }

  .ai-collection-page__price-range-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .ai-collection-page__price-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ settings.input_corner_radius }}px;
    font-size: 14px;
  }

  .ai-collection-page__products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.product_grid_gap }}px;
    margin-bottom: 40px;
  }

  .ai-collection-page__product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-page__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.product_card_background }};
    border-radius: {{ block.settings.product_card_radius }}px;
    margin-bottom: 12px;
  }

  .ai-collection-page__product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-page__product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-page__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-page__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 500;
    margin-bottom: 6px;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__product-price--sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-collection-page__product-compare-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
  }

  .ai-collection-page__pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
  }

  .ai-collection-page__pagination-link-{{ ai_gen_id }} {
    padding: 10px 16px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ settings.input_corner_radius }}px;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    background-color: {{ settings.background_color }};
  }

  .ai-collection-page__pagination-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-collection-page__pagination-link--active-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-collection-page__pagination-link--disabled-{{ ai_gen_id }} {
    opacity: 0.3;
    pointer-events: none;
  }

  .ai-collection-page__drawer-overlay-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-collection-page__drawer-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-collection-page__drawer-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: -100%;
    width: 85%;
    max-width: 400px;
    height: 100%;
    background-color: {{ settings.background_color }};
    z-index: 1000;
    overflow-y: auto;
    transition: left 0.3s ease;
    padding: 24px;
  }

  .ai-collection-page__drawer-{{ ai_gen_id }}.active {
    left: 0;
  }

  .ai-collection-page__drawer-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-collection-page__drawer-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__drawer-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: center;
  }

  .ai-collection-page__drawer-apply-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ settings.input_corner_radius }}px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    margin-top: 24px;
  }

  .ai-collection-page__drawer-apply-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-collection-page__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
  }

  .ai-collection-page__empty-title-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-page__empty-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-page__products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 767px) {
    .ai-collection-page-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ settings.min_page_margin }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-collection-page__sidebar-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collection-page__mobile-toggle-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-collection-page__drawer-overlay-{{ ai_gen_id }},
    .ai-collection-page__drawer-{{ ai_gen_id }} {
      display: block;
    }

    .ai-collection-page__products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-collection-page__header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-collection-page__sort-{{ ai_gen_id }} {
      width: 100%;
      justify-content: space-between;
    }

    .ai-collection-page__sort-select-{{ ai_gen_id }} {
      flex: 1;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-collection-page__products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<collection-filters-{{ ai_gen_id }} class="ai-collection-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-page__container-{{ ai_gen_id }}">
    <aside class="ai-collection-page__sidebar-{{ ai_gen_id }}">
      <div class="ai-collection-page__filters-{{ ai_gen_id }}">
        {% for filter in collection.filters %}
          <div class="ai-collection-page__filter-group-{{ ai_gen_id }}">
            <h3 class="ai-collection-page__filter-title-{{ ai_gen_id }}">{{ filter.label }}</h3>
            
            {% case filter.type %}
              {% when 'list' %}
                {% for value in filter.values %}
                  <div class="ai-collection-page__filter-option-{{ ai_gen_id }}">
                    <input
                      type="checkbox"
                      id="filter-{{ ai_gen_id }}-{{ filter.param_name }}-{{ forloop.index }}"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      class="ai-collection-page__filter-checkbox-{{ ai_gen_id }}"
                      {% if value.active %}checked{% endif %}
                      data-filter-type="list"
                    >
                    <label
                      for="filter-{{ ai_gen_id }}-{{ filter.param_name }}-{{ forloop.index }}"
                      class="ai-collection-page__filter-label-{{ ai_gen_id }}"
                    >
                      {{ value.label }}
                      <span class="ai-collection-page__filter-count-{{ ai_gen_id }}">({{ value.count }})</span>
                    </label>
                  </div>
                {% endfor %}
              
              {% when 'price_range' %}
                <div class="ai-collection-page__price-range-{{ ai_gen_id }}">
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    id="filter-{{ ai_gen_id }}-price-min"
                    class="ai-collection-page__price-input-{{ ai_gen_id }}"
                    placeholder="{{ filter.range_min | money_without_currency | replace: ',', '' }}"
                    min="{{ filter.range_min | money_without_currency | replace: ',', '' }}"
                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                    data-filter-type="price"
                  >
                  <span>-</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    id="filter-{{ ai_gen_id }}-price-max"
                    class="ai-collection-page__price-input-{{ ai_gen_id }}"
                    placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    min="{{ filter.range_min | money_without_currency | replace: ',', '' }}"
                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                    data-filter-type="price"
                  >
                </div>
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    </aside>

    <div class="ai-collection-page__main-{{ ai_gen_id }}">
      <div class="ai-collection-page__header-{{ ai_gen_id }}">
        <button
          class="ai-collection-page__mobile-toggle-{{ ai_gen_id }}"
          aria-label="Open filters"
          aria-expanded="false"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="17" y2="6"></line>
            <line x1="3" y1="10" x2="17" y2="10"></line>
            <line x1="3" y1="14" x2="17" y2="14"></line>
          </svg>
          Filter & Sort
        </button>

        <div class="ai-collection-page__count-{{ ai_gen_id }}">
          {{ collection.products_count }}
          {% if collection.products_count == 1 %}
            product
          {% else %}
            products
          {% endif %}
        </div>

        <div class="ai-collection-page__sort-{{ ai_gen_id }}">
          <label for="sort-{{ ai_gen_id }}" class="ai-collection-page__sort-label-{{ ai_gen_id }}">Sort by:</label>
          <select
            id="sort-{{ ai_gen_id }}"
            class="ai-collection-page__sort-select-{{ ai_gen_id }}"
            name="sort_by"
          >
            <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
            <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best selling</option>
            <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Alphabetically, A-Z</option>
            <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>Alphabetically, Z-A</option>
            <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price, low to high</option>
            <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price, high to low</option>
            <option value="created-ascending" {% if collection.sort_by == 'created-ascending' %}selected{% endif %}>Date, old to new</option>
            <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Date, new to old</option>
          </select>
        </div>
      </div>

      {% if collection.filters.size > 0 %}
        {% assign active_filters_count = 0 %}
        {% for filter in collection.filters %}
          {% if filter.type == 'list' %}
            {% for value in filter.values %}
              {% if value.active %}
                {% assign active_filters_count = active_filters_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% elsif filter.type == 'price_range' %}
            {% if filter.min_value.value or filter.max_value.value %}
              {% assign active_filters_count = active_filters_count | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if active_filters_count > 0 %}
          <div class="ai-collection-page__active-filters-{{ ai_gen_id }}">
            {% for filter in collection.filters %}
              {% if filter.type == 'list' %}
                {% for value in filter.values %}
                  {% if value.active %}
                    <div class="ai-collection-page__filter-pill-{{ ai_gen_id }}">
                      {{ filter.label }}: {{ value.label }}
                      <button
                        class="ai-collection-page__filter-pill-remove-{{ ai_gen_id }}"
                        data-filter-remove="{{ value.url_to_remove }}"
                        aria-label="Remove filter {{ value.label }}"
                      >
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
                          <line x1="2" y1="2" x2="12" y2="12"></line>
                          <line x1="12" y1="2" x2="2" y2="12"></line>
                        </svg>
                      </button>
                    </div>
                  {% endif %}
                {% endfor %}
              {% elsif filter.type == 'price_range' %}
                {% if filter.min_value.value or filter.max_value.value %}
                  <div class="ai-collection-page__filter-pill-{{ ai_gen_id }}">
                    {% if filter.min_value.value and filter.max_value.value %}
                      {{ filter.min_value.value | money }} - {{ filter.max_value.value | money }}
                    {% elsif filter.min_value.value %}
                      From {{ filter.min_value.value | money }}
                    {% elsif filter.max_value.value %}
                      Up to {{ filter.max_value.value | money }}
                    {% endif %}
                    <button
                      class="ai-collection-page__filter-pill-remove-{{ ai_gen_id }}"
                      data-filter-remove="{{ filter.url_to_remove }}"
                      aria-label="Remove price filter"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="2" y1="2" x2="12" y2="12"></line>
                        <line x1="12" y1="2" x2="2" y2="12"></line>
                      </svg>
                    </button>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
            
            <button
              class="ai-collection-page__clear-all-{{ ai_gen_id }}"
              data-clear-all="{{ collection.url }}"
            >
              Clear all
            </button>
          </div>
        {% endif %}
      {% endif %}

      {% if collection.products.size > 0 %}
        <div class="ai-collection-page__products-grid-{{ ai_gen_id }}">
          {% for product in collection.products %}
            <a href="{{ product.url }}" class="ai-collection-page__product-card-{{ ai_gen_id }}">
              <div class="ai-collection-page__product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-collection-page__product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-collection-page__product-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <h3 class="ai-collection-page__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <div class="ai-collection-page__product-price-{{ ai_gen_id }} {% if product.compare_at_price > product.price %}ai-collection-page__product-price--sale-{{ ai_gen_id }}{% endif %}">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="ai-collection-page__product-compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="ai-collection-page__pagination-{{ ai_gen_id }}">
            {% if paginate.previous %}
              <a
                href="{{ paginate.previous.url }}"
                class="ai-collection-page__pagination-link-{{ ai_gen_id }}"
              >
                Previous
              </a>
            {% else %}
              <span class="ai-collection-page__pagination-link-{{ ai_gen_id }} ai-collection-page__pagination-link--disabled-{{ ai_gen_id }}">
                Previous
              </span>
            {% endif %}

            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a
                  href="{{ part.url }}"
                  class="ai-collection-page__pagination-link-{{ ai_gen_id }}"
                >
                  {{ part.title }}
                </a>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="ai-collection-page__pagination-link-{{ ai_gen_id }} ai-collection-page__pagination-link--active-{{ ai_gen_id }}">
                    {{ part.title }}
                  </span>
                {% else %}
                  <span class="ai-collection-page__pagination-link-{{ ai_gen_id }}">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <a
                href="{{ paginate.next.url }}"
                class="ai-collection-page__pagination-link-{{ ai_gen_id }}"
              >
                Next
              </a>
            {% else %}
              <span class="ai-collection-page__pagination-link-{{ ai_gen_id }} ai-collection-page__pagination-link--disabled-{{ ai_gen_id }}">
                Next
              </span>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <div class="ai-collection-page__empty-state-{{ ai_gen_id }}">
          <h2 class="ai-collection-page__empty-title-{{ ai_gen_id }}">No products found</h2>
          <p class="ai-collection-page__empty-text-{{ ai_gen_id }}">Try adjusting your filters or search criteria</p>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ai-collection-page__drawer-overlay-{{ ai_gen_id }}" aria-hidden="true"></div>
  
  <aside
    class="ai-collection-page__drawer-{{ ai_gen_id }}"
    role="dialog"
    aria-modal="true"
    aria-label="Filters"
  >
    <div class="ai-collection-page__drawer-header-{{ ai_gen_id }}">
      <h2 class="ai-collection-page__drawer-title-{{ ai_gen_id }}">Filter & Sort</h2>
      <button
        class="ai-collection-page__drawer-close-{{ ai_gen_id }}"
        aria-label="Close filters"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="ai-collection-page__filters-{{ ai_gen_id }}">
      {% for filter in collection.filters %}
        <div class="ai-collection-page__filter-group-{{ ai_gen_id }}">
          <h3 class="ai-collection-page__filter-title-{{ ai_gen_id }}">{{ filter.label }}</h3>
          
          {% case filter.type %}
            {% when 'list' %}
              {% for value in filter.values %}
                <div class="ai-collection-page__filter-option-{{ ai_gen_id }}">
                  <input
                    type="checkbox"
                    id="drawer-filter-{{ ai_gen_id }}-{{ filter.param_name }}-{{ forloop.index }}"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    class="ai-collection-page__filter-checkbox-{{ ai_gen_id }}"
                    {% if value.active %}checked{% endif %}
                    data-filter-type="list"
                  >
                  <label
                    for="drawer-filter-{{ ai_gen_id }}-{{ filter.param_name }}-{{ forloop.index }}"
                    class="ai-collection-page__filter-label-{{ ai_gen_id }}"
                  >
                    {{ value.label }}
                    <span class="ai-collection-page__filter-count-{{ ai_gen_id }}">({{ value.count }})</span>
                  </label>
                </div>
              {% endfor %}
            
            {% when 'price_range' %}
              <div class="ai-collection-page__price-range-{{ ai_gen_id }}">
                <input
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  id="drawer-filter-{{ ai_gen_id }}-price-min"
                  class="ai-collection-page__price-input-{{ ai_gen_id }}"
                  placeholder="{{ filter.range_min | money_without_currency | replace: ',', '' }}"
                  min="{{ filter.range_min | money_without_currency | replace: ',', '' }}"
                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                  data-filter-type="price"
                >
                <span>-</span>
                <input
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  id="drawer-filter-{{ ai_gen_id }}-price-max"
                  class="ai-collection-page__price-input-{{ ai_gen_id }}"
                  placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  min="{{ filter.range_min | money_without_currency | replace: ',', '' }}"
                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                  data-filter-type="price"
                >
              </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    <button class="ai-collection-page__drawer-apply-{{ ai_gen_id }}">
      Apply filters
    </button>
  </aside>
</collection-filters-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionFilters{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mobileToggle = this.querySelector('.ai-collection-page__mobile-toggle-{{ ai_gen_id }}');
        this.drawer = this.querySelector('.ai-collection-page__drawer-{{ ai_gen_id }}');
        this.drawerOverlay = this.querySelector('.ai-collection-page__drawer-overlay-{{ ai_gen_id }}');
        this.drawerClose = this.querySelector('.ai-collection-page__drawer-close-{{ ai_gen_id }}');
        this.drawerApply = this.querySelector('.ai-collection-page__drawer-apply-{{ ai_gen_id }}');
        this.sortSelect = this.querySelector('.ai-collection-page__sort-select-{{ ai_gen_id }}');
        this.filterCheckboxes = this.querySelectorAll('.ai-collection-page__filter-checkbox-{{ ai_gen_id }}');
        this.priceInputs = this.querySelectorAll('.ai-collection-page__price-input-{{ ai_gen_id }}');
        this.filterRemoveButtons = this.querySelectorAll('.ai-collection-page__filter-pill-remove-{{ ai_gen_id }}');
        this.clearAllButton = this.querySelector('.ai-collection-page__clear-all-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.mobileToggle) {
          this.mobileToggle.addEventListener('click', () => this.openDrawer());
        }

        if (this.drawerClose) {
          this.drawerClose.addEventListener('click', () => this.closeDrawer());
        }

        if (this.drawerOverlay) {
          this.drawerOverlay.addEventListener('click', () => this.closeDrawer());
        }

        if (this.drawerApply) {
          this.drawerApply.addEventListener('click', () => {
            this.applyFilters();
            this.closeDrawer();
          });
        }

        if (this.sortSelect) {
          this.sortSelect.addEventListener('change', (e) => {
            const url = new URL(window.location.href);
            url.searchParams.set('sort_by', e.target.value);
            window.location.href = url.toString();
          });
        }

        this.filterCheckboxes.forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            if (window.innerWidth >= 768) {
              this.applyFilters();
            }
          });
        });

        this.priceInputs.forEach((input) => {
          input.addEventListener('change', () => {
            if (window.innerWidth >= 768) {
              this.applyFilters();
            }
          });
        });

        this.filterRemoveButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const removeUrl = button.getAttribute('data-filter-remove');
            if (removeUrl) {
              window.location.href = removeUrl;
            }
          });
        });

        if (this.clearAllButton) {
          this.clearAllButton.addEventListener('click', (e) => {
            e.preventDefault();
            const clearUrl = this.clearAllButton.getAttribute('data-clear-all');
            if (clearUrl) {
              window.location.href = clearUrl;
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.drawer.classList.contains('active')) {
            this.closeDrawer();
          }
        });
      }

      openDrawer() {
        this.drawer.classList.add('active');
        this.drawerOverlay.classList.add('active');
        this.mobileToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        this.drawerClose.focus();
      }

      closeDrawer() {
        this.drawer.classList.remove('active');
        this.drawerOverlay.classList.remove('active');
        this.mobileToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        this.mobileToggle.focus();
      }

      applyFilters() {
        const url = new URL(window.location.href);
        const params = new URLSearchParams();

        const sortBy = url.searchParams.get('sort_by');
        if (sortBy) {
          params.set('sort_by', sortBy);
        }

        this.filterCheckboxes.forEach((checkbox) => {
          if (checkbox.checked) {
            params.append(checkbox.name, checkbox.value);
          }
        });

        this.priceInputs.forEach((input) => {
          if (input.value) {
            params.set(input.name, input.value);
          }
        });

        const newUrl = window.location.pathname + '?' + params.toString();
        window.location.href = newUrl;
      }
    }

    customElements.define('collection-filters-{{ ai_gen_id }}', CollectionFilters{{ ai_gen_id }});
  })();
</script>

