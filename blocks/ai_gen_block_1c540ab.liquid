{% doc %}
  @prompt
    create an standard and custom contact us page
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-contact-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-contact-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-contact-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-contact-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  @media screen and (min-width: 750px) {
    .ai-contact-content-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.layout == 'side-by-side' %}1fr 1fr{% else %}1fr{% endif %};
      gap: 60px;
    }
  }

  .ai-contact-info-{{ ai_gen_id }} {
    {% if block.settings.layout == 'form-only' %}
      display: none;
    {% endif %}
  }

  .ai-contact-info-title-{{ ai_gen_id }} {
    font-size: 24px;
    color: {{ block.settings.title_color }};
    margin: 0 0 24px;
    font-weight: 600;
  }

  .ai-contact-info-items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-contact-info-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .ai-contact-info-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
    margin-top: 2px;
  }

  .ai-contact-info-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-contact-info-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0 0 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-contact-info-value-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-contact-info-value-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-contact-info-value-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    padding: {{ block.settings.form_padding }}px;
    border-radius: {{ block.settings.form_border_radius }}px;
    {% if block.settings.form_border_width > 0 %}
      border: {{ block.settings.form_border_width }}px solid {{ block.settings.form_border_color }};
    {% endif %}
  }

  .ai-contact-form-title-{{ ai_gen_id }} {
    font-size: 24px;
    color: {{ block.settings.title_color }};
    margin: 0 0 24px;
    font-weight: 600;
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.input_background_color }};
    font-family: inherit;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 150px;
    resize: vertical;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: {% if block.settings.button_full_width %}100%{% else %}auto{% endif %};
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
  }

  .ai-contact-hours-{{ ai_gen_id }} {
    {% if block.settings.show_hours == false %}
      display: none;
    {% endif %}
    background-color: {{ block.settings.hours_background_color }};
    padding: 32px;
    border-radius: {{ block.settings.form_border_radius }}px;
    text-align: center;
  }

  .ai-contact-hours-title-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-contact-hours-content-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
  }
{% endstyle %}

<contact-page-{{ ai_gen_id }} class="ai-contact-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-contact-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h1 class="ai-contact-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-contact-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-contact-content-{{ ai_gen_id }}">
      <div class="ai-contact-info-{{ ai_gen_id }}">
        <h2 class="ai-contact-info-title-{{ ai_gen_id }}">{{ block.settings.info_title }}</h2>
        <div class="ai-contact-info-items-{{ ai_gen_id }}">
          {% if block.settings.show_email and block.settings.email != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="ai-contact-info-content-{{ ai_gen_id }}">
                <p class="ai-contact-info-label-{{ ai_gen_id }}">Email</p>
                <p class="ai-contact-info-value-{{ ai_gen_id }}">
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                </p>
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_phone and block.settings.phone != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="ai-contact-info-content-{{ ai_gen_id }}">
                <p class="ai-contact-info-label-{{ ai_gen_id }}">Phone</p>
                <p class="ai-contact-info-value-{{ ai_gen_id }}">
                  <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
                </p>
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_address and block.settings.address != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="ai-contact-info-content-{{ ai_gen_id }}">
                <p class="ai-contact-info-label-{{ ai_gen_id }}">Address</p>
                <div class="ai-contact-info-value-{{ ai_gen_id }}">{{ block.settings.address }}</div>
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_social and block.settings.social_links != blank %}
            <div class="ai-contact-info-item-{{ ai_gen_id }}">
              <div class="ai-contact-info-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
                </svg>
              </div>
              <div class="ai-contact-info-content-{{ ai_gen_id }}">
                <p class="ai-contact-info-label-{{ ai_gen_id }}">Follow Us</p>
                <div class="ai-contact-info-value-{{ ai_gen_id }}">{{ block.settings.social_links }}</div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
        <h2 class="ai-contact-form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h2>
        {%- form 'contact' -%}
          {% if form.posted_successfully? %}
            <div class="ai-contact-form-success-{{ ai_gen_id }}" id="ai-contact-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="ai-contact-form-error-{{ ai_gen_id }}" id="ai-contact-error-{{ ai_gen_id }}">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="ai-contact-form-{{ ai_gen_id }}">
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                Name <span style="color: {{ block.settings.error_text_color }};">*</span>
              </label>
              <input
                type="text"
                id="contact-name-{{ ai_gen_id }}"
                name="contact[name]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                value="{% if form.name %}{{ form.name }}{% endif %}"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="ai-contact-error-{{ ai_gen_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="ai-contact-success-{{ ai_gen_id }}"
                {% endif %}
              >
            </div>

            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                Email <span style="color: {{ block.settings.error_text_color }};">*</span>
              </label>
              <input
                type="email"
                id="contact-email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                value="{% if form.email %}{{ form.email }}{% endif %}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="ai-contact-error-{{ ai_gen_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="ai-contact-success-{{ ai_gen_id }}"
                {% endif %}
              >
            </div>

            {% if block.settings.show_phone_field %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label for="contact-phone-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                  Phone {% if block.settings.phone_required %}<span style="color: {{ block.settings.error_text_color }};">*</span>{% endif %}
                </label>
                <input
                  type="tel"
                  id="contact-phone-{{ ai_gen_id }}"
                  name="contact[phone]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  value="{% if form.phone %}{{ form.phone }}{% endif %}"
                  autocomplete="tel"
                  {% if block.settings.phone_required %}required{% endif %}
                >
              </div>
            {% endif %}

            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                Message <span style="color: {{ block.settings.error_text_color }};">*</span>
              </label>
              <textarea
                id="contact-message-{{ ai_gen_id }}"
                name="contact[body]"
                class="ai-contact-form-textarea-{{ ai_gen_id }}"
                required
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>

    {% if block.settings.show_hours %}
      <div class="ai-contact-hours-{{ ai_gen_id }}">
        <h3 class="ai-contact-hours-title-{{ ai_gen_id }}">{{ block.settings.hours_title }}</h3>
        <div class="ai-contact-hours-content-{{ ai_gen_id }}">{{ block.settings.hours_content }}</div>
      </div>
    {% endif %}
  </div>
</contact-page-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form && form.classList.contains('posted-successfully')) {
          const successMessage = this.querySelector('.ai-contact-form-success-{{ ai_gen_id }}');
          if (successMessage) {
            successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      }
    }

    customElements.define('contact-page-{{ ai_gen_id }}', ContactPage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Contact us page",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        {
          "value": "side-by-side",
          "label": "Side by side"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "form-only",
          "label": "Form only"
        }
      ],
      "default": "side-by-side"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Page header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Get in Touch"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Subtitle size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "inline_richtext",
      "id": "info_title",
      "label": "Section title",
      "default": "Contact Information"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "contact@bestoffragrances.com"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "checkbox",
      "id": "show_address",
      "label": "Show address",
      "default": true
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>123 Fragrance Lane<br>New York, NY 10001<br>United States</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "richtext",
      "id": "social_links",
      "label": "Social media text",
      "default": "<p>Follow us on Instagram, Facebook, and Twitter</p>"
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "inline_richtext",
      "id": "form_title",
      "label": "Form title",
      "default": "Send us a Message"
    },
    {
      "type": "checkbox",
      "id": "show_phone_field",
      "label": "Show phone field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "phone_required",
      "label": "Phone field required",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Send Message"
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Full width button",
      "default": false
    },
    {
      "type": "richtext",
      "id": "success_message",
      "label": "Success message",
      "default": "<p>Thank you for contacting us! We'll get back to you as soon as possible.</p>"
    },
    {
      "type": "range",
      "id": "form_padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Form padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "form_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Form border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "form_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Form border width",
      "default": 0
    },
    {
      "type": "header",
      "content": "Business hours"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show business hours",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "hours_title",
      "label": "Hours title",
      "default": "Business Hours"
    },
    {
      "type": "richtext",
      "id": "hours_content",
      "label": "Hours content",
      "default": "<p>Monday - Friday: 9:00 AM - 6:00 PM EST<br>Saturday: 10:00 AM - 4:00 PM EST<br>Sunday: Closed</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#0066CC"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "form_background_color",
      "label": "Form background",
      "default": "#F9F9F9"
